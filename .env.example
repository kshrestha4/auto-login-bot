LOGIN_USERNAME=your_username
LOGIN_PASSWORD=your_password
LOGIN_URL=https://example.com/login

# Selenium selectors: update these for the authorized website.
USERNAME_SELECTOR_TYPE=name
USERNAME_SELECTOR_VALUE=username
PASSWORD_SELECTOR_TYPE=name
PASSWORD_SELECTOR_VALUE=password
LOGIN_BUTTON_SELECTOR_TYPE=css selector
LOGIN_BUTTON_SELECTOR_VALUE=button[type='submit']

# Choose URL, element, or either verification mode.
SUCCESS_CHECK_TYPE=url
SUCCESS_URL_CONTAINS=/dashboard
SUCCESS_SELECTOR_TYPE=css selector
SUCCESS_SELECTOR_VALUE=.account-menu
WAIT_TIMEOUT_SECONDS=15
DRY_RUN=false
HEADLESS=false
